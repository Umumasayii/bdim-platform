# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata, sitemap and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (database, authentication, storage) ─────────────────────────
# Leave empty to run in demo mode (local JSON data file + browser-only progress).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to save bookings/inquiries and by the seed script.
# NEVER expose this in client code or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ── Local development admin (only used when Supabase is NOT configured) ──
# Password: 8+ characters. Secret: 32+ random characters (e.g. `openssl rand -hex 32`).
LOCAL_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: where the local JSON data store lives (default: ./.data)
BDIM_DATA_DIR=

# ── Email notifications via Resend (optional) ────────────────────────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "BDIM <hello@your-domain>"
EMAIL_FROM=
# Where staff notifications (new bookings/inquiries) are sent
BDIM_NOTIFICATION_EMAIL=

# ── Public contact details shown on the site (optional) ──────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Official logo, e.g. /brand/bdim-logo.svg after placing it in public/brand/
NEXT_PUBLIC_LOGO_URL=

# Payments are disabled until prices are formally set and a provider is configured.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
